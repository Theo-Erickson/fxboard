<?xml version="1.0" encoding="utf-8"?>
<!-- Fork additions (Theo's FUTO Keyboard fork). Not translated upstream, so marked non-translatable. -->
<resources>
    <string name="fork_settings_title" translatable="false">Fork extras</string>
    <string name="fork_settings_subtitle" translatable="false">Unofficial modified build: spacebar, navigation bar and keypress effects</string>

    <string name="fork_settings_cursor_section" translatable="false">Cursor and navigation bar</string>
    <string name="fork_spacebar_vertical_title" translatable="false">Drag spacebar up and down to change lines</string>
    <string name="fork_spacebar_vertical_subtitle" translatable="false">Works alongside the normal left and right cursor drag. Only multi-line text fields respond.</string>
    <string name="fork_hide_nav_bar_title" translatable="false">Hide keyboard navigation bar</string>
    <string name="fork_hide_nav_bar_subtitle" translatable="false">Removes the down arrow and keyboard switcher below the keys. Requires Android 15 or newer.</string>

    <string name="fork_settings_effects_section" translatable="false">Keypress effects</string>
    <string name="fork_effect_ripple_title" translatable="false">Ripple</string>
    <string name="fork_effect_ripple_subtitle" translatable="false">A ring expands from where you touch</string>
    <string name="fork_effect_glow_title" translatable="false">Key glow</string>
    <string name="fork_effect_glow_subtitle" translatable="false">The pressed key flashes and fades</string>
    <string name="fork_effect_particles_title" translatable="false">Particles</string>
    <string name="fork_effect_particles_subtitle" translatable="false">A small burst of sparks on each press</string>
    <string name="fork_effect_trail_title" translatable="false">Spacebar trail</string>
    <string name="fork_effect_trail_subtitle" translatable="false">A glowing trail follows your finger while dragging the cursor</string>

    <string name="fork_modified_notice" translatable="false">This is an unofficial, modified version of FUTO Keyboard. It is not made or supported by FUTO. Please report issues with this build to the fork, not to FUTO.</string>
</resources>
